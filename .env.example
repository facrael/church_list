# Application
APP_NAME="Religious Marketplace API"
APP_VERSION="1.0.0"
DEBUG=true

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/church_marketplace

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# 2GIS Maps API
DGIS_API_KEY=your-2gis-api-key

# YooKassa Payment
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Commission rates (decimal)
SERVICE_COMMISSION_RATE=0.07
DONATION_COMMISSION_RATE=0.04
